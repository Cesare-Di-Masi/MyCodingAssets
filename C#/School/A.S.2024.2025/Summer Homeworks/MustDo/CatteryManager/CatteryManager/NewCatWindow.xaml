<Window x:Class="CatteryManager.NewCatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CatteryManager"
        mc:Ignorable="d"
        Title="Cattery - Add New Cat" Height="500" Width="400">
    <Grid Margin="10">
        <StackPanel>
            <TextBlock Text="Add New Cat" FontSize="20" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>

            <TextBlock Text="Name:"/>
            <TextBox x:Name="txtName" Margin="0,0,0,10"/>

            <TextBlock Text="Breed:"/>
            <ComboBox x:Name="cmbBreed" Margin="0,0,0,10" SelectedIndex="0"/>

            <TextBlock Text="Gender:"/>
            <ComboBox x:Name="cmbGender" Margin="0,0,0,10" SelectedIndex="0">
                <ComboBoxItem Content="Male"/>
                <ComboBoxItem Content="Female"/>
            </ComboBox>

            <TextBlock Text="Arrival Date:"/>
            <DatePicker x:Name="dpArrivalDate" Margin="0,0,0,10" SelectedDate="{x:Static sys:DateTime.Now}" xmlns:sys="clr-namespace:System;assembly=mscorlib"/>

            <TextBlock Text="Birth Date (optional):"/>
            <DatePicker x:Name="dpBirthDate" Margin="0,0,0,10"/>

            <TextBlock Text="Description:"/>
            <TextBox x:Name="txtDescription" Margin="0,0,0,10" AcceptsReturn="True" Height="80" TextWrapping="Wrap"/>

            <Button Content="Add Cat" Width="100" HorizontalAlignment="Center" Click="BtnAddCat_Click"/>
        </StackPanel>
    </Grid>
</Window>
