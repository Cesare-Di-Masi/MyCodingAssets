<Window x:Class="CatteryManager.CanceledAdoptionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CatteryManager"
        mc:Ignorable="d"
         Title="Cattery - Failed Adoption" Height="350" Width="500">
    <Grid Margin="10">
        <StackPanel>
            <TextBlock Text="Manage Failed Adoption" FontSize="20" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>

            <TextBlock Text="Select Adoption:"/>
            <ComboBox x:Name="cmbAdoptions" DisplayMemberPath="DisplayInfo" Margin="0,0,0,10"/>

            <Button Content="Mark as Failed" Width="150" HorizontalAlignment="Center" Click="BtnMarkFailed_Click"/>
        </StackPanel>
    </Grid>
</Window>
