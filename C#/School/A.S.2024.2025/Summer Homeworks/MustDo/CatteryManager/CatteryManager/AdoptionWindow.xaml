<Window x:Class="CatteryManager.AdoptionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CatteryManager"
        mc:Ignorable="d"
        Title="Cattery - Adoptions" Height="400" Width="700">
    <Grid Margin="10">
        <StackPanel>
            <TextBlock Text="Registered Adoptions" FontSize="20" FontWeight="Bold" Margin="0,0,0,10" HorizontalAlignment="Center"/>

            <DataGrid x:Name="dgAdoptions" AutoGenerateColumns="False" IsReadOnly="True" Height="300">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Cat Name" Binding="{Binding Cat.Name}" Width="*"/>
                    <DataGridTextColumn Header="Breed" Binding="{Binding Cat.Breed}" Width="*"/>
                    <DataGridTextColumn Header="Adopter Name" Binding="{Binding Adopter.FullName}" Width="*"/>
                    <DataGridTextColumn Header="Address" Binding="{Binding Adopter.Address}" Width="*"/>
                    <DataGridTextColumn Header="Phone" Binding="{Binding Adopter.Phone}" Width="*"/>
                    <DataGridTextColumn Header="Adoption Date" Binding="{Binding AdoptionDate}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </Grid>
</Window>
