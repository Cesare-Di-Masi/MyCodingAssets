<Window x:Class="SpellArchive.SchoolWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestione Scuole di Magia" Height="400" Width="500">

    <StackPanel Margin="10">
        <TextBlock Text="Cerca Scuola:" />
        <StackPanel Orientation="Horizontal">
            <TextBox x:Name="TxtSearchSchool" Width="200" />
            <Button x:Name="BtnSearchSchool" Content="Cerca" Margin="5,0,0,0" />
        </StackPanel>

        <ListBox x:Name="LstSchools" Height="150" Margin="0,10,0,10" />

        <TextBlock Text="Aggiungi Nuova Scuola:" />
        <TextBox x:Name="TxtNewSchool" Width="200" />
        <Button x:Name="BtnAddSchool" Content="Aggiungi Scuola" Width="150" Margin="0,5,0,0" Click="BtnAddSchool_Click" />
    </StackPanel>
</Window>