<Window x:Class="SpellArchiveApp.SpellsBySchoolWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Incantesimi per Scuola" Height="400" Width="600">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0">
            <TextBlock Text="Seleziona Scuola:" VerticalAlignment="Center" />
            <ComboBox x:Name="CmbSchools" Width="200" Margin="10,0,0,0" />
            <Button x:Name="BtnLoadSpells" Content="Carica" Margin="10,0,0,0" />
        </StackPanel>

        <ListView x:Name="LstSpells" Grid.Row="1" Margin="0,10,0,0">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="CRA" DisplayMemberBinding="{Binding CRA}" Width="120" />
                    <GridViewColumn Header="Nome" DisplayMemberBinding="{Binding Name}" Width="150" />
                    <GridViewColumn Header="Pericolo" DisplayMemberBinding="{Binding DangerLevel}" Width="80" />
                    <GridViewColumn Header="Mago" DisplayMemberBinding="{Binding Wizard.Name}" Width="120" />
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Window>