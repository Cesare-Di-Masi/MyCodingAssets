<Window x:Class="SpellArchive.AddModifySpellWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aggiungi o Modifica Incantesimo" Height="500" Width="600">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10">

            <TextBlock Text="Nome:" />
            <TextBox x:Name="TxtName" Width="300" />

            <TextBlock Text="Descrizione:" Margin="0,10,0,0" />
            <TextBox x:Name="TxtDescription" Width="300" Height="60" TextWrapping="Wrap" />

            <TextBlock Text="Mago:" Margin="0,10,0,0" />
            <ComboBox x:Name="CmbWizard" Width="300" />

            <TextBlock Text="Data Creazione:" Margin="0,10,0,0" />
            <DatePicker x:Name="DpCreationDate" Width="200" />

            <TextBlock Text="Accessibilità:" Margin="0,10,0,0" />
            <ComboBox x:Name="CmbAccessibility" Width="200" />

            <TextBlock Text="Livello di Pericolo:" Margin="0,10,0,0" />
            <Slider x:Name="SldDanger" Minimum="0" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" Width="200" />

            <TextBlock Text="Scuole di Magia:" Margin="0,10,0,0" />
            <ListBox x:Name="LstSchools" SelectionMode="Multiple" Height="100" Width="300" />

            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                <Button x:Name="BtnSave" Content="Salva" Width="100" Click="BtnSave_Click" />
                <Button x:Name="BtnCancel" Content="Annulla" Width="100" Margin="10,0,0,0" Click="BtnCancel_Click" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>