<Window x:Class="Presentation_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Presentation_WPF.Converter"
        Title="Task Manager" Height="720" Width="1080"
        Background="#F8FAFC" FontFamily="Segoe UI">

    <Window.Resources>
        <conv:TaskStateToBrushConverter x:Key="TaskStateToBrush" />
        <conv:TaskGroupStateToBrushConverter x:Key="GroupStateToBrush" />
        <conv:TaskListToProgressTextConverter x:Key="TaskListToProgress" />

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="20,16" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.05" Color="#000000" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#3B82F6" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2563EB" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#1D4ED8" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#94A3B8" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#1E293B" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0F172A" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#020617" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,4,0,12" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="White" />
        </Style>

        <Style x:Key="InputCombo" TargetType="ComboBox">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,4,0,12" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="White" />
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <Style TargetType="ListViewItem">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Style="{StaticResource Card}" Grid.Row="0" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Task Manager" FontSize="26" FontWeight="Bold" Foreground="#0F172A" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Foreground="#64748B">
                            <Run Text="{Binding CompletedCount, Mode=OneWay}" />
                            <Run Text=" / " />
                            <Run Text="{Binding TotalCount, Mode=OneWay}" />
                            <Run Text=" completati" />
                        </TextBlock>
                    </StackPanel>
                    <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Minimum="0" Maximum="100"
                                 Height="6" Width="240" Margin="0,8,0,0"
                                 Foreground="#3B82F6" Background="#E2E8F0" BorderThickness="0" />
                </StackPanel>
                <Button Grid.Column="1" Content="Avvia tutti" Style="{StaticResource PrimaryButton}"
                        Command="{Binding StartAllCommand}" VerticalAlignment="Center" Padding="24,10" />
            </Grid>
        </Border>

        <!-- Main content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left panel -->
            <StackPanel Grid.Column="0">
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Nuovo task" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Nome" Style="{StaticResource Label}" />
                        <TextBox Style="{StaticResource InputBox}" Text="{Binding NewTaskName, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Durata (secondi)" Style="{StaticResource Label}" />
                        <TextBox Style="{StaticResource InputBox}" Text="{Binding NewTaskDurationSeconds, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Gruppo (opzionale)" Style="{StaticResource Label}" />
                        <ComboBox Style="{StaticResource InputCombo}" ItemsSource="{Binding TaskGroups}"
                                  DisplayMemberPath="GroupName" SelectedValuePath="GroupId"
                                  SelectedValue="{Binding NewTaskGroupId}" />
                        <Button Content="Aggiungi task" Style="{StaticResource SecondaryButton}"
                                Command="{Binding AddTaskCommand}" HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Nuovo gruppo" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Nome gruppo" Style="{StaticResource Label}" />
                        <TextBox Style="{StaticResource InputBox}" Text="{Binding NewGroupName, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="Aggiungi gruppo" Style="{StaticResource SecondaryButton}"
                                Command="{Binding AddGroupCommand}" HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding StatusMessage}" Foreground="#EF4444" FontSize="13" TextWrapping="Wrap" />
            </StackPanel>

            <!-- Right panel -->
            <TabControl Grid.Column="2" Background="Transparent" BorderThickness="0" Margin="0,0,0,10">
                <TabItem Header="Task standalone">
                    <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                        <ListView ItemsSource="{Binding Tasks}" BorderThickness="0" Background="Transparent">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Nome" DisplayMemberBinding="{Binding Name}" Width="260" />
                                    <GridViewColumn Header="Durata (s)" DisplayMemberBinding="{Binding EstimatedTimeSeconds}" Width="120" />
                                    <GridViewColumn Header="Stato" Width="140">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource Badge}"
                                                        Background="{Binding State, Converter={StaticResource TaskStateToBrush}}">
                                                    <TextBlock Text="{Binding State}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                                                </Border>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Border>
                </TabItem>

                <TabItem Header="Gruppi">
                    <ScrollViewer Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding TaskGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding GroupName}" FontWeight="Bold" FontSize="18" Foreground="#0F172A" />
                                                    <Border Style="{StaticResource Badge}"
                                                            Background="{Binding State, Converter={StaticResource GroupStateToBrush}}"
                                                            Margin="0,6,0,0">
                                                        <TextBlock Text="{Binding State}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                                                    </Border>
                                                    <TextBlock Text="{Binding Tasks, Converter={StaticResource TaskListToProgress}}"
                                                               Foreground="#64748B" Margin="0,6,0,0" FontSize="13" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="Avvia gruppo" Style="{StaticResource SecondaryButton}"
                                                        Command="{Binding DataContext.StartGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding GroupId}" VerticalAlignment="Top" Padding="16,8" />
                                            </Grid>

                                            <ItemsControl ItemsSource="{Binding Tasks}" Margin="0,12,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Name}" Grid.Column="0" Foreground="#1E293B" FontSize="14" />
                                                            <TextBlock Text="{Binding EstimatedTimeSeconds}" Grid.Column="1" Foreground="#94A3B8" Margin="0,0,12,0" FontSize="13" />
                                                            <Border Style="{StaticResource Badge}" Grid.Column="2"
                                                                    Background="{Binding State, Converter={StaticResource TaskStateToBrush}}">
                                                                <TextBlock Text="{Binding State}" Foreground="White" FontSize="10" FontWeight="SemiBold" />
                                                            </Border>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>