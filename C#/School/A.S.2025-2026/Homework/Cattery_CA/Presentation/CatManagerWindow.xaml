<Window x:Class="Presentation.CatManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Presentation"
        mc:Ignorable="d"
        Title="CatManagerWindow" Height="450" Width="800" Background="#2B2B2B">
    
        <Window.Resources>
            <Style TargetType="MenuItem">
                <Setter Property="Foreground" Value="Black" />
                <Setter Property="FontWeight" Value="Bold" />
            </Style>
        </Window.Resources>

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <!-- Menu -->
                <RowDefinition Height="5" />
                <!-- Titolo -->
                <RowDefinition Height="*" />
                <!-- Corpo -->
            </Grid.RowDefinitions>

            <!-- Rettangolo Verde con Menu -->
            <Border Grid.Row="0" Background="#2ECC71" Padding="10"
     CornerRadius="0,0,6,6">
                <DockPanel>
                    <Menu DockPanel.Dock="Top" Background="#27AE60" Foreground="Black" FontWeight="Bold">
                        <MenuItem Header="Cats">
                            <MenuItem Header="Add" />
                            <MenuItem Header="See All" />
                        </MenuItem>
                        <MenuItem Header="_Adoption">
                            <MenuItem Header="Adopt" />
                            <MenuItem Header="See All" />
                        </MenuItem>
                        <MenuItem Header="_Account">
                            <MenuItem Header="Guida" />
                            <MenuItem Header="Informazioni su..." />
                        </MenuItem>
                    </Menu>
                </DockPanel>
            </Border>

        <DataGrid x:Name="dgCats" AutoGenerateColumns="False" MaxHeight="300" Margin="0,0,265,358" Grid.RowSpan="2" Grid.Row="1" >
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" />
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" IsReadOnly="True"/>
                <DataGridCheckBoxColumn Header="IsMale" Binding="{Binding IsMale}" IsReadOnly="True"/>
                <DataGridTextColumn Header="Arrived in" Binding="{Binding ArrivingDate, StringFormat={}{0:dd/MM/yyyy}}" IsReadOnly="True"/>
                <DataGridTextColumn Header="Born in" Binding="{Binding BirthDate,StringFormat={}{0:dd/MM/yyyy}, TargetNullValue='Not Adopted'}" IsReadOnly="True" />
                <DataGridTextColumn Header="Description" Binding="{Binding Description, TargetNullValue='no description'}" IsReadOnly="True" />
                <DataGridTextColumn Header="Breed" Binding="{Binding BreedName, TargetNullValue='no breed'}" IsReadOnly="True" />

            </DataGrid.Columns>
            

        </DataGrid>

    </Grid>
</Window>
